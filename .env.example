# =============================================================================
# Real Trading & Claim 환경변수
# 이 파일을 .env로 복사한 후 값을 채워주세요: cp .env.example .env
# =============================================================================

# === Polymarket 계정 (Trading & Claim 공통) ===
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here
POLYMARKET_PROXY_ADDRESS=0x_your_proxy_address_here

# === Polymarket V2 (선택) ===
# Builder code (Builder 프로그램 등록한 경우만). bytes32 hex.
# 미설정 시 attribution 없이 거래.
POLYMARKET_BUILDER_CODE=
# CLOB host override.
# - 4/28 ~11:00 UTC cutover로 V1→V2 전환 (같은 URL이 V2 backend로 교체).
# - 4/28 이전에 V2 미리 검증하려면: https://clob-v2.polymarket.com
# - 보통 비워두면 됨 (config.py 기본값 = clob.polymarket.com 사용).
POLYMARKET_HOST=
# Claim용 collateral (선택). 비우면 USDC.e (V1, 기존 마켓 redeem).
# V2 cutover 이후 새로 생성된 마켓은 pUSD: 0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
CLAIM_COLLATERAL_ADDRESS=

# === Builder API (Claim용 - 필수) ===
# Polymarket에서 Builder API 키 발급 필요
BUILDER_API_KEY_1=
BUILDER_SECRET_1=
BUILDER_PASS_PHRASE_1=

# === Telegram 알림 (선택) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
